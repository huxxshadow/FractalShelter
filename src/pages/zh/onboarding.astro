</Layout>

<script>
    import { gsap } from "gsap";

    // --- Fast-Forward State ---
    let handshakeTimeline = null;
    let isFastForward = false;
    let ffRing = null;


    // ==========================================
    // 1. 动态生成占位符按钮逻辑
    // ==========================================
    const fillPlaceholderButtons = () => {
        const list = document.getElementById('procedure-list');
        const container = list?.parentElement;
        if (!list || !container) return;

        // 清理旧的占位符
        list.querySelectorAll('.dynamic-placeholder').forEach(el => el.remove());
        const realItems = Array.from(list.children);
        if (realItems.length === 0) return;

        const lastRealItem = realItems[realItems.length - 1];
        const containerBottom = container.getBoundingClientRect().bottom;
        const lastItemBottom = lastRealItem.getBoundingClientRect().bottom;

        const remainingHeight = containerBottom - lastItemBottom;
        const itemHeight = 88; // 预估单个项目的整体高度

        const neededItems = Math.floor(remainingHeight / itemHeight);
        if (neededItems > 0) {
            const fragment = document.createDocumentFragment();
            for (let i = 0; i < neededItems; i++) {
                const li = document.createElement('li');
                li.className = "flex items-center procedure-item dynamic-placeholder";
                li.innerHTML = `
                    <div class="w-3 h-3 bg-gray-200 ring-4 ring-white rounded-full shrink-0 z-10"></div>
                    <div class="w-4 shrink-0"></div>
                    <div class="flex-grow bg-gray-50 text-gray-400 p-4 flex items-center gap-3 cursor-not-allowed hover:bg-gray-100 transition-colors rounded-l-md rounded-r-full border border-gray-100 border-l-0">
                        <svg class="w-7 h-7 shrink-0 opacity-50" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3M18,20V10H6V20H18Z" />
                        </svg>
                        <span class="block text-lg font-bold tracking-wide whitespace-nowrap">......</span>
                        <div class="ml-auto shrink-0 text-gray-400 text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-gray-200 mr-1 bg-white whitespace-nowrap">
                            锁定
                        </div>
                    </div>
                `;
                fragment.appendChild(li);
            }
            list.appendChild(fragment);
        }
    };

    // ==========================================
    // 2. Handshake 节点路径计算
    // ==========================================
    function initHandshake() {
        const container = document.getElementById('handshake-container');
        const bgPath = document.getElementById('bg-path');
        const activePath = document.getElementById('active-path');

        const nodes = Array.from(document.querySelectorAll('.node-btn')).sort((a, b) => {
            return parseInt(a.dataset.index) - parseInt(b.dataset.index);
        });

        if (!container || nodes.length === 0) return null;

        let distances = [0];
        let totalDist = 0;

        const updatePath = () => {
            const containerRect = container.getBoundingClientRect();
            let points = nodes.map(node => {
                const rect = node.getBoundingClientRect();
                return {
                    x: rect.left + rect.width / 2 - containerRect.left,
                    y: rect.top + rect.height / 2 - containerRect.top
                };
            });

            let d = `M ${points[0].x} ${points[0].y} `;
            distances = [0];
            totalDist = 0;

            for(let i = 1; i < points.length; i++) {
                d += `L ${points[i].x} ${points[i].y} `;
                let dx = points[i].x - points[i-1].x;
                let dy = points[i].y - points[i-1].y;
                totalDist += Math.sqrt(dx*dx + dy*dy);
                distances.push(totalDist);
            }

            bgPath.setAttribute('d', d);
            activePath.setAttribute('d', d);

            return totalDist;
        };

        const pathLength = updatePath();

        gsap.set(activePath, {
            strokeDasharray: pathLength,
            strokeDashoffset: pathLength
        });

        return { pathLength, nodes, distances, updatePath };
    }

    // ==========================================
    // 3. 播放 Handshake 连线动画
    // ==========================================
    function playSequence() {
        const setup = initHandshake();
        if(!setup) return;

        const { nodes, pathLength, distances } = setup;
        const activePath = document.getElementById('active-path');
        const statusText = document.getElementById('handshake-status');
        const topProgressBar = document.getElementById('handshake-progress-bar');
        const btnComplete = document.getElementById('btn-handshake-complete');

        // Assign to our global variable instead of local 'tl'
        handshakeTimeline = gsap.timeline({
            delay: 0.2,
            onComplete: () => {
                statusText.textContent = "已建立";
                statusText.classList.replace('text-gray-400', 'text-[#D00000]');
                statusText.classList.add('font-black');
                stopFastForward(); // Turn off ring when done
            }
        });

        const totalDuration = 4.5;

        handshakeTimeline.to(activePath, {
            strokeDashoffset: 0,
            duration: totalDuration,
            ease: "none"
        }, 0);

        handshakeTimeline.to(topProgressBar, {
            width: "100%",
            duration: totalDuration,
            ease: "none"
        }, 0);

        nodes.forEach((node, i) => {
            const label = node.parentElement.querySelector('.node-label');
            const ratio = distances[i] / pathLength;
            const delay = ratio * totalDuration;

            handshakeTimeline.add(() => {
                statusText.textContent = `同步节点_${i+1}...`;
                const numSpan = node.querySelector('span');
                numSpan.classList.replace('text-gray-200', 'text-[#D00000]');
                label.classList.replace('text-gray-300', 'text-[#D00000]');
                label.classList.add('font-bold');
            }, delay);
        });

        handshakeTimeline.to(btnComplete, {
            opacity: 1,
            y: 0,
            pointerEvents: "auto",
            duration: 0.4,
            ease: "power2.out"
        }, "+=0.3");

        // If the user is already holding down the mouse when the sequence starts
        if (isFastForward) {
            handshakeTimeline.timeScale(8);
        }
    }

    // ==========================================
    // 4. 计算左侧侧边栏轨道进度
    // ==========================================
    function updateSidebarProgress(targetId) {
        const track = document.getElementById('sidebar-track');
        const progress = document.getElementById('sidebar-progress');
        const targetLi = document.getElementById(targetId);

        if (!track || !progress || !targetLi) return;

        const dot = targetLi.querySelector('.w-3.h-3');
        if (!dot) return;

        const trackRect = track.getBoundingClientRect();
        const dotRect = dot.getBoundingClientRect();
        const targetHeight = (dotRect.top - trackRect.top) + (dotRect.height / 2);

        progress.style.height = `${targetHeight}px`;
        track.dataset.activeStep = targetId;
    }

    // ==========================================
    // 5. 停止快进函数
    // ==========================================
    function stopFastForward() {
        isFastForward = false;
        if (ffRing) gsap.to(ffRing, { opacity: 0, scale: 0.8, duration: 0.2 });

        // Smoothly return timeline to normal speed
        if (handshakeTimeline && handshakeTimeline.isActive()) {
            gsap.to(handshakeTimeline, { timeScale: 1, duration: 0.2 });
        }
    }

    // ==========================================
    // 6. Astro ViewTransitions 核心接管逻辑
    // ==========================================
    document.addEventListener('astro:page-load', () => {

        // 身份验证：只在中文页面执行
        const mainInterface = document.getElementById('main-interface');
        if (!mainInterface || mainInterface.dataset.lang !== 'zh') return;

        // 先生成占位列表，确保布局高度完整
        fillPlaceholderButtons();

        // 绑定窗口调整大小事件
        window.addEventListener('resize', () => {
            fillPlaceholderButtons();

            // 修正左侧红线高度
            const track = document.getElementById('sidebar-track');
            if (track && track.dataset.activeStep) {
                updateSidebarProgress(track.dataset.activeStep);
            }

            // 修正中央连线
            const container = document.getElementById('handshake-container');
            const activePath = document.getElementById('active-path');
            if(container && activePath) {
                const setup = initHandshake();
                if(setup && gsap.getProperty(activePath, "strokeDashoffset") === 0) {
                    gsap.set(activePath, { strokeDasharray: setup.pathLength, strokeDashoffset: 0 });
                }
            }
        });

        // --- 核心入场动画 ---
        // 1. 初始化时，先隐藏除了 Logo 以外的所有主要内容
        gsap.set(['header h1', 'main'], { opacity: 0, y: 20 });

        // 2. 等待 Logo 跨页飞行完成 (约 0.4s) 后，再将新界面的元素浮现出来
        gsap.to(['header h1', 'main'], {
            opacity: 1,
            y: 0,
            duration: 0.6,
            delay: 0.4, // 等待 ViewTransitions 的 Logo 飞行
            ease: "power3.out",
            stagger: 0.1, // 标题和下方控制台错开浮现
            onComplete: () => {
                // 界面完全显示完成后，启动左侧进度拉伸和核心握手动画
                updateSidebarProgress('step-procedure');
                playSequence();
            }
        });

        // --- 确认按钮点击逻辑 ---
        const btnComplete = document.getElementById('btn-handshake-complete');
        if (btnComplete) {
            btnComplete.addEventListener('click', () => {
                btnComplete.disabled = true;
                const tl = gsap.timeline();

                tl.to(btnComplete, { opacity: 0, y: 10, duration: 0.2, pointerEvents: "none" });

                tl.add(() => {
                    const stepHandshake = document.getElementById('step-handshake');
                    if (stepHandshake) {
                        const body = stepHandshake.querySelector('.flex-grow');
                        const badge = stepHandshake.querySelector('.ml-auto');
                        const dot = stepHandshake.querySelector('.w-3.h-3');
                        const icon = stepHandshake.querySelector('svg');
                        const textSpan = stepHandshake.querySelector('span');

                        body.className = "flex-grow bg-[#D00000] text-white p-4 flex items-center gap-3 cursor-pointer hover:bg-red-700 transition-colors rounded-l-md rounded-r-full shadow-md";
                        badge.className = "ml-auto shrink-0 bg-white text-[#D00000] text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full mr-1 shadow-sm whitespace-nowrap";
                        badge.textContent = "进行中";
                        dot.className = "w-3 h-3 bg-[#D00000] ring-4 ring-white rounded-full shrink-0 transition-transform group-hover:scale-110 z-10";
                        icon.classList.replace('opacity-50', 'opacity-100');
                        textSpan.classList.replace('font-bold', 'font-black');

                        updateSidebarProgress('step-handshake');
                    }
                }, "+=0.1");


                // 3. Crossfade the main containers
                tl.to('#handshake-container', {
                    opacity: 0,
                    y: -20,
                    duration: 0.3,
                    onComplete: () => {
                        document.getElementById('handshake-container').classList.add('hidden');
                        document.getElementById('identity-container').classList.remove('hidden');

                        // Update Header Text
                        document.getElementById('section-title').textContent = "身份录入";

                        const statusText = document.getElementById('handshake-status');
                        statusText.textContent = "等待输入";
                        statusText.classList.replace('text-[#D00000]', 'text-gray-400');
                        statusText.classList.remove('font-black');

                        gsap.set('#handshake-progress-bar', { width: "0%" });
                    }
                })
                    // Set initial state for identity container before fading in
                    .fromTo('#identity-container',
                        { opacity: 0, y: 20 },
                        { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }
                    );
            });
        }


// --- Fast-Forward Logic & Listeners ---
        ffRing = document.getElementById('ff-ring');

        const onMouseMove = (e) => {
            if (ffRing) gsap.to(ffRing, { x: e.clientX, y: e.clientY, duration: 0.15, ease: "power2.out" });
        };
        window.addEventListener('mousemove', onMouseMove);

        const triggerFF = (e) => {
            // Ignore clicks on buttons (like the Complete button)
            if (e && e.target.tagName.toLowerCase() === 'button') return;
            // Only fast-forward if the handshake animation is currently running
            if (!handshakeTimeline || !handshakeTimeline.isActive()) return;

            isFastForward = true;
            if (ffRing) gsap.to(ffRing, { opacity: 1, scale: 1, duration: 0.2, ease: "back.out(2)" });

            // Smoothly speed up the GSAP timeline 8x
            gsap.to(handshakeTimeline, { timeScale: 8, duration: 0.2 });
        };

        window.addEventListener('mousedown', triggerFF);
        window.addEventListener('mouseup', stopFastForward);
        window.addEventListener('mouseleave', stopFastForward);

        // Cleanup listeners when navigating away
        document.addEventListener('astro:before-swap', () => {
            window.removeEventListener('mousemove', onMouseMove);
            window.removeEventListener('mousedown', triggerFF);
            window.removeEventListener('mouseup', stopFastForward);
            window.removeEventListener('mouseleave', stopFastForward);
        }, { once: true });

    });


    // --- Identity Form Validation ---
    document.addEventListener('astro:page-load', () => {
        // 身份验证：只在中文页面执行
        const mainInterface = document.getElementById('main-interface');
        if (!mainInterface || mainInterface.dataset.lang !== 'zh') return;

        const nameInput = document.getElementById('legal-name');
        const codenameInput = document.getElementById('codename');
        const draftBadge = document.getElementById('draft-badge');
        const nameError = document.getElementById('name-error');

        const ageSelect = document.getElementById('age');
        const monthSelect = document.getElementById('month');
        const genderRadios = document.querySelectorAll('input[name="gender"]');

        const deptFractal = document.getElementById('dept-fractal');

        const btnSubmitIdentity = document.getElementById('btn-submit-identity');
        const clearanceCheckbox = document.getElementById('clearance');

        if (!btnSubmitIdentity || !nameInput) return;

        function validateIdentityForm() {
            const nameVal = nameInput.value.trim();
            const codenameVal = codenameInput.value.trim();
            const isNameValid = nameVal.length >= 1 && nameVal.length <= 24;
            const isAgeSelected = ageSelect.value !== "";
            const isMonthSelected = monthSelect.value !== "";
            const isGenderSelected = document.querySelector('input[name="gender"]:checked') !== null;

            const isDepartmentSelected = deptFractal ? deptFractal.checked : false;
            const isClearanceSelected = clearanceCheckbox ? clearanceCheckbox.checked : false;

            const toggleFilledState = (el, hasValue) => {
                const group = el.closest('.group');
                const label = group ? group.querySelector('label') : null;
                const icon = group ? group.querySelector('svg') : null;
                const defaultTextClass = el.tagName === 'SELECT' ? 'text-gray-400' : 'text-gray-800';

                if (hasValue) {
                    el.classList.remove('text-gray-400', 'text-gray-800', 'border-gray-200');
                    el.classList.add('text-[#D00000]', 'border-[#D00000]');
                    if (label) {
                        label.classList.remove('text-gray-400');
                        label.classList.add('text-[#D00000]');
                    }
                    if (icon && el.tagName === 'SELECT') {
                        icon.classList.remove('text-gray-400');
                        icon.classList.add('text-[#D00000]');
                    }
                } else {
                    el.classList.remove('text-[#D00000]', 'border-[#D00000]');
                    el.classList.add(defaultTextClass, 'border-gray-200');
                    if (label) {
                        label.classList.remove('text-[#D00000]');
                        label.classList.add('text-gray-400');
                    }
                    if (icon && el.tagName === 'SELECT') {
                        icon.classList.remove('text-[#D00000]');
                        icon.classList.add('text-gray-400');
                    }
                }
            };

            toggleFilledState(nameInput, nameVal.length > 0);
            toggleFilledState(codenameInput, codenameVal.length > 0);
            toggleFilledState(ageSelect, isAgeSelected);
            toggleFilledState(monthSelect, isMonthSelected);

            const genderLabel = document.getElementById('gender-label');
            if (genderLabel) {
                if (isGenderSelected) {
                    genderLabel.classList.remove('text-gray-400');
                    genderLabel.classList.add('text-[#D00000]');
                } else {
                    genderLabel.classList.remove('text-[#D00000]');
                    genderLabel.classList.add('text-gray-400');
                }
            }

            const deptLabel = document.getElementById('department-label');
            if (deptLabel) {
                if (isDepartmentSelected) {
                    deptLabel.classList.remove('text-gray-400');
                    deptLabel.classList.add('text-[#D00000]');
                } else {
                    deptLabel.classList.remove('text-[#D00000]');
                    deptLabel.classList.add('text-gray-400');
                }
            }

            const clearanceLabel = document.getElementById('clearance-label');
            if (clearanceLabel) {
                if (isClearanceSelected) {
                    clearanceLabel.classList.remove('text-gray-400');
                    clearanceLabel.classList.add('text-[#D00000]');
                } else {
                    clearanceLabel.classList.remove('text-[#D00000]');
                    clearanceLabel.classList.add('text-gray-400');
                }
            }

            if (nameVal.length > 0) {
                draftBadge.classList.remove('opacity-0');
            } else {
                draftBadge.classList.add('opacity-0');
            }

            if (nameInput.value.length > 0 && !isNameValid) {
                nameError.classList.remove('hidden');
            } else {
                nameError.classList.add('hidden');
            }

            // 计算表单完成进度
            let completedSteps = 0;
            if (isNameValid) completedSteps++;
            if (isAgeSelected) completedSteps++;
            if (isMonthSelected) completedSteps++;
            if (isGenderSelected) completedSteps++;
            if (isDepartmentSelected) completedSteps++;
            if (isClearanceSelected) completedSteps++;

            const totalSteps = 6;
            const progressPercent = (completedSteps / totalSteps) * 100;
            const isFormComplete = completedSteps === totalSteps;

            // 动画更新顶部进度条
            const topProgressBar = document.getElementById('handshake-progress-bar');
            if (topProgressBar) {
                gsap.to(topProgressBar, { width: `${progressPercent}%`, duration: 0.3, ease: "power2.out" });
            }

            // 更新右上角状态文字
            const statusText = document.getElementById('handshake-status');
            if (statusText) {
                if (isFormComplete) {
                    statusText.textContent = "已验证";
                    statusText.classList.replace('text-gray-400', 'text-[#D00000]');
                    statusText.classList.add('font-black');
                } else {
                    statusText.textContent = `已完成 ${Math.round(progressPercent)}%`;
                    statusText.classList.replace('text-[#D00000]', 'text-gray-400');
                    statusText.classList.remove('font-black');
                }
            }

            // 获取 Deployment Node 容器
            const deploymentSection = document.getElementById('deployment-section');

            // 终极解锁判定
            if (isFormComplete) {
                btnSubmitIdentity.disabled = false;
                btnSubmitIdentity.className = "px-12 py-4 bg-[#D00000] text-white font-bold tracking-widest uppercase transition-all hover:bg-[#a00000] flex items-center gap-3 shadow-lg hover:shadow-xl hover:-translate-y-1 cursor-pointer";

                if (deploymentSection) deploymentSection.classList.add('is-ready');
            } else {
                btnSubmitIdentity.disabled = true;
                btnSubmitIdentity.className = "px-12 py-4 bg-gray-200 text-gray-400 font-bold tracking-widest uppercase transition-all flex items-center gap-3 cursor-not-allowed";

                if (deploymentSection) deploymentSection.classList.remove('is-ready');
            }
        }

        nameInput?.addEventListener('input', validateIdentityForm);
        codenameInput?.addEventListener('input', validateIdentityForm);
        ageSelect?.addEventListener('change', validateIdentityForm);
        monthSelect?.addEventListener('change', validateIdentityForm);
        genderRadios.forEach(radio => radio.addEventListener('change', validateIdentityForm));
        deptFractal?.addEventListener('change', validateIdentityForm);
        clearanceCheckbox?.addEventListener('change', validateIdentityForm);

        btnSubmitIdentity.addEventListener('click', () => {
            const formData = {
                legal_name: nameInput.value.trim(),
                codename: codenameInput.value.trim() || nameInput.value.trim(),
                age: parseInt(ageSelect.value),
                birth_month: parseInt(monthSelect.value),
                gender: document.querySelector('input[name="gender"]:checked').value,
                department: deptFractal.value,
                rank: "intern",
                rank_locked: true
            };

            console.log("受试者已注册:", formData);
        });
    });

</script>
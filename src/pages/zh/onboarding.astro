---
import Layout from '../../layouts/Layout.astro';
import "../../styles/global.css";
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import guideImage from '../../assets/character1.png';
---

<Layout>
    <div id="main-interface" data-lang="zh" class="min-h-screen bg-white flex flex-col p-6 pb-0 overflow-hidden selection:bg-[#D00000] selection:text-white">
        <header class=" mb-4 border-b-12 border-[#D00000] pb-4 flex justify-between items-end shrink-0">
            <h1 class="text-[#D00000] text-6xl font-black tracking-wide uppercase">
                欢迎来到分形庇护所
            </h1>
            <Icon class="inline-block w-16 h-16 text-[#D00000] " name="logo"  id="hero-logo" transition:name="fractal-logo"></Icon>
        </header>

        <main class="grid grid-cols-16 gap-12 flex-grow h-full min-h-0 mt-4">

            <section class="col-span-9 flex flex-col relative overflow-hidden pr-0 bg-transparent border-none">

                <div class="flex items-center gap-4 mb-4 text-[#D00000]">
                    <h2 id="section-title" class="text-5xl font-black tracking-widest uppercase">会话握手</h2>

                    <div class="h-3 flex-grow bg-gray-100 relative">
                        <div id="handshake-progress-bar" class="absolute top-0 left-0 h-full bg-[#D00000] w-0"></div>
                    </div>
                    <span id="handshake-status" class=" text-xl font-bold uppercase text-gray-400 min-w-[120px] text-right">等待中</span>
                </div>

                <div id="handshake-container" class="flex-grow relative w-full mt-8 mb-8">
                    <svg class="absolute inset-0 w-full h-full z-0 pointer-events-none">
                        <path id="bg-path" fill="none" stroke="#f3f4f6" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter" />
                        <path id="active-path" fill="none" stroke="#D00000" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter" />
                    </svg>

                    <div class="relative z-10 grid grid-cols-3 gap-y-16 w-full h-full px-12 pb-8">
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="0">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">01</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">链接</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="1">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">02</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">认证</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="2">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">03</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">同步</span>
                        </div>

                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="5">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">06</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">路由</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="4">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">05</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">解密</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="3">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">04</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">验证</span>
                        </div>

                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="6">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">07</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">映射</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="7">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">08</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">注入</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="8">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">09</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">连接</span>
                        </div>
                    </div>

                    <button id="btn-handshake-complete" class="absolute bottom-4 right-8 opacity-0 pointer-events-none translate-y-4 px-10 py-4 bg-[#D00000] text-white font-bold tracking-widest uppercase transition-colors hover:bg-[#a00000] z-20">
                        建立连接
                    </button>
                </div>

                <div id="identity-container" class="flex-grow relative w-full mt-4 mb-8 hidden opacity-0 flex-col justify-center">
                    <div class="bg-gray-50 border-l-8 border-[#D00000] p-10 shadow-lg mx-8 relative overflow-hidden">
                        <Icon name="mdi:card-account-details-outline" class="absolute -bottom-10 -right-10 w-64 h-64 text-gray-100 rotate-12 pointer-events-none" />

                        <div class="relative z-10">
                            <h3 class="text-4xl font-black text-[#D00000] uppercase mb-8 tracking-wide">受试者登记</h3>

                            <div class="space-y-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="flex flex-col group">
                                        <label class="text-base font-black text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="legal-name">
                                            姓名 <span class="text-[#D00000]">*</span>
                                        </label>
                                        <input type="text" id="legal-name" maxlength="24" class="bg-white border-2 border-gray-200 p-3 font-bold text-lg  text-gray-800 focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all placeholder:text-gray-300" placeholder="请输入姓名..." autocomplete="off" />
                                        <span id="name-error" class="text-xs text-[#D00000] mt-1 hidden ">姓名为必填项，且不能仅包含空格。</span>
                                    </div>
                                    <div class="flex flex-col group relative">
                                        <label class="text-base font-black font-bold text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="codename">
                                            代号 / 别名
                                        </label>
                                        <input type="text" id="codename" maxlength="20" class="bg-white border-2 border-gray-200 p-3 text-lg font-bold text-gray-800 focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all placeholder:text-gray-300" placeholder="选填（例如：ARCH-02）" autocomplete="off" />
                                        <div id="draft-badge" class="absolute right-3 top-[48px] opacity-0 transition-opacity pointer-events-none">
                                            <span class="bg-gray-100 text-gray-400 border border-gray-200 text-[12px] font-black px-2 py-1 rounded-sm uppercase tracking-widest">草稿</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div class="flex flex-col group">
                                        <label class=" text-base font-black font-bold text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="age">
                                            年龄 <span class="text-[#D00000]">*</span>
                                        </label>
                                        <div class="relative">
                                            <select id="age" class="w-full bg-white border-2 border-gray-200 p-3 text-lg text-gray-400 font-bold focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all appearance-none cursor-pointer">
                                                <option value="" selected disabled hidden>选择年龄...</option>
                                                {Array.from({ length: 45 }, (_, i) => i + 16).map((age) => (
                                                        <option value={age}>{age}岁</option>
                                                ))}
                                            </select>
                                            <Icon name="mdi:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col group">
                                        <label class=" text-base font-black text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="month">
                                            出生月份 <span class="text-[#D00000]">*</span>
                                        </label>
                                        <div class="relative">
                                            <select id="month" class="w-full bg-white border-2 border-gray-200 p-3 text-lg text-gray-400 font-bold focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all appearance-none cursor-pointer">
                                                <option value="" selected disabled hidden>选择月份...</option>

                                                {[
                                                    {val: 1, label: "01 - 一月"}, {val: 2, label: "02 - 二月"}, {val: 3, label: "03 - 三月"},
                                                    {val: 4, label: "04 - 四月"}, {val: 5, label: "05 - 五月"}, {val: 6, label: "06 - 六月"},
                                                    {val: 7, label: "07 - 七月"}, {val: 8, label: "08 - 八月"}, {val: 9, label: "09 - 九月"},
                                                    {val: 10, label: "10 - 十月"}, {val: 11, label: "11 - 十一月"}, {val: 12, label: "12 - 十二月"}
                                                ].map(m => <option value={m.val}>{m.label}</option>)}
                                            </select>
                                            <Icon name="mdi:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col group" id="gender-section">
                                        <label id="gender-label" class="text-base font-black text-gray-400 uppercase tracking-widest mb-2 transition-colors">
                                            性别 <span class="text-[#D00000]">*</span>
                                        </label>

                                        <div class="flex items-center gap-4 w-full h-[52px]">

                                            <label class="flex-1 h-full cursor-pointer relative group/btn">
                                                <input type="radio" name="gender" value="M" class="peer sr-only">
                                                <div class="w-full h-full border-2 border-gray-200 bg-white flex items-center justify-center text-gray-400 transition-all duration-300
                                                    group-hover/btn:border-gray-300 group-hover/btn:bg-gray-50
                                                     peer-checked:border-[#D00000] peer-checked:text-[#D00000] peer-checked:bg-red-50/20 peer-checked:shadow-[0_0_10px_rgba(208,0,0,0.2)]">
                                                    <Icon name="mdi:gender-male" class="w-7 h-7" />
                                                </div>
                                            </label>

                                            <label class="flex-1 h-full cursor-pointer relative group/btn">
                                                <input type="radio" name="gender" value="F" class="peer sr-only">
                                                <div class="w-full h-full border-2 border-gray-200 bg-white flex items-center justify-center text-gray-400 transition-all duration-300
                                                    group-hover/btn:border-gray-300 group-hover/btn:bg-gray-50
                                                    peer-checked:border-[#D00000] peer-checked:text-[#D00000] peer-checked:bg-red-50/20 peer-checked:shadow-[0_0_10px_rgba(208,0,0,0.2)]">
                                                    <Icon name="mdi:gender-female" class="w-7 h-7" />
                                                </div>
                                            </label>

                                            <label class="flex-1 h-full cursor-pointer relative group/btn">
                                                <input type="radio" name="gender" value="X" class="peer sr-only">
                                                <div class="w-full h-full border-2 border-gray-200 bg-white flex items-center justify-center text-gray-400 transition-all duration-300
                                                group-hover/btn:border-gray-300 group-hover/btn:bg-gray-50
                                                peer-checked:border-[#D00000] peer-checked:text-[#D00000] peer-checked:bg-red-50/20 peer-checked:shadow-[0_0_10px_rgba(208,0,0,0.2)]">
                                                    <Icon name="mdi:gender-non-binary" class="w-7 h-7" />
                                                </div>
                                            </label>

                                        </div>
                                    </div>


                                </div>


                                <div class="flex flex-col pt-2">
                                    <label id="department-label" class=" text-base font-black text-gray-400 uppercase tracking-widest mb-3 transition-colors">
                                        所属分支 <span class="text-[#D00000]">*</span>
                                    </label>
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                                        <label class="relative cursor-pointer group">
                                            <input type="checkbox" id="dept-fractal" name="department" value="fractal" class="peer sr-only">

                                            <div class="border-2 border-gray-200 bg-white text-[#D00000] p-4 transition-all flex flex-col items-center text-center h-full
                        hover:border-red-300 peer-checked:border-[#D00000] peer-checked:bg-[#D00000] peer-checked:text-white">
                                                <Icon name="logo" class="w-16 h-16 group-hover:scale-110 transition-transform" />
                                                <span class="font-black tracking-wide text-3xl uppercase mt-2">分形</span>
                                            </div>

                                            <div class="absolute top-2 right-2 opacity-0 peer-checked:opacity-100 transition-opacity">
                                                <Icon name="mdi:check-circle" class="w-5 h-5 text-white" />
                                            </div>
                                        </label>

                                        <div class="locked-dept relative cursor-not-allowed group">
                                            <div class="border-2 border-[#0058C0] bg-[#0058C0] text-white p-4 transition-all flex flex-col items-center text-center h-full opacity-90 hover:opacity-100">
                                                <Icon name="mdi:weather-hurricane" class="w-16 h-16 group-hover:scale-110 transition-transform" />
                                                <span class="font-black tracking-wide text-3xl uppercase mt-2">湮灭</span>
                                            </div>
                                            <div class="absolute top-2 right-2 lock-icon">
                                                <Icon name="mdi:lock" class="w-5 h-5 text-white/70" />
                                            </div>
                                        </div>

                                        <div class="locked-dept relative cursor-not-allowed group">
                                            <div class="border-2 border-[#009900] bg-[#009900] text-white p-4 transition-all flex flex-col items-center text-center h-full opacity-90 hover:opacity-100">
                                                <Icon name="mdi:seed-outline" class="w-16 h-16 group-hover:scale-110 transition-transform" />
                                                <span class="font-black tracking-wide text-3xl uppercase mt-2">起源</span>
                                            </div>
                                            <div class="absolute top-2 right-2 lock-icon">
                                                <Icon name="mdi:lock" class="w-5 h-5 text-white/70" />
                                            </div>
                                        </div>

                                    </div>
                                </div>


                                <div class="flex flex-col mt-4 pt-6 border-t-2 border-gray-100 group">
                                    <label id="clearance-label" class="text-base font-black text-gray-400 uppercase tracking-widest mb-3 transition-colors">
                                        初始许可等级 <span class="text-[#D00000]">*</span>
                                    </label>

                                    <label class="relative cursor-pointer">
                                        <input type="checkbox" id="clearance" name="clearance" value="intern" class="peer sr-only">

                                        <div class="bg-white border-2 border-gray-200 flex items-stretch h-20 transition-colorspeer-checked:border-[#D00000] peer-checked:[&_.status-bar]:bg-[#D00000] peer-checked:[&_.status-icon]:text-[#D00000]">

                                            <div class="status-bar w-3 bg-gray-200 transition-colors"></div>

                                            <div class="flex-grow flex items-center justify-between px-5">

                                                <div class="flex items-center gap-5">
                                                    <Icon name="mdi:badge-account-horizontal-outline" class="status-icon w-8 h-8 text-gray-400 transition-colors" />

                                                    <div class="flex flex-col">
                                                        <span class="text-xl font-black text-gray-800 uppercase tracking-widest">实习生</span>
                                                        <span class="text-base font-bold text-gray-500 uppercase tracking-[0.2em] mt-0.5">分配职级</span>
                                                    </div>
                                                </div>

                                                <div class="flex flex-col items-end justify-center border-l-2 border-gray-100 pl-6">
                                                    <span class="text-base font-bold text-gray-500 uppercase tracking-widest mb-1">状态</span>
                                                    <span class="text-base font-black text-gray-500 uppercase tracking-widest ">预审批</span>
                                                </div>

                                            </div>
                                        </div>
                                    </label>
                                </div>

                                <div id="deployment-section" class="flex flex-col mt-4 pt-6 border-t-2 border-gray-100 group/node">
                                    <label class="text-base font-black text-gray-400 uppercase tracking-widest mb-3 transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]">
                                        部署节点
                                    </label>

                                    <div class="bg-gray-50 border-2 border-gray-200 flex items-stretch h-16 relative select-none pointer-events-none transition-colors duration-500 group-[.is-ready]/node:border-[#D00000]">

                                        <div class="absolute inset-0 opacity-50 transition-all duration-500 group-[.is-ready]/node:opacity-10" style="background-image: repeating-linear-gradient(45deg, #e5e7eb 0, #e5e7eb 2px, transparent 2px, transparent 8px);"></div>

                                        <div class="absolute inset-0 opacity-0 transition-all duration-500 group-[.is-ready]/node:opacity-20" style="background-image: repeating-linear-gradient(45deg, #D00000 0, #D00000 2px, transparent 2px, transparent 8px);"></div>

                                        <div class="w-3 bg-gray-300 relative z-10 transition-colors duration-500 group-[.is-ready]/node:bg-[#D00000]"></div>

                                        <div class="flex-grow flex items-center justify-between px-5 relative z-10">

                                            <div class="flex items-center gap-5">
                                                <Icon name="mdi:crosshairs-gps" class="w-7 h-7 text-gray-400 transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]" />
                                                <div class="flex items-baseline gap-2">
                                                    <span class="text-sm font-bold text-gray-400 uppercase tracking-widest transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]">节点:</span>
                                                    <span class="text-xl font-black text-gray-600 uppercase tracking-widest transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]">FS-001</span>
                                                </div>
                                            </div>

                                            <div class="flex flex-col items-end justify-center border-l-2 border-gray-200 pl-6 transition-colors duration-500 group-[.is-ready]/node:border-red-200">
                                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1 transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]">访问权限</span>
                                                <span class="text-sm font-black text-gray-500 uppercase tracking-widest transition-colors duration-500 group-[.is-ready]/node:text-[#D00000]">
                                                    只读
                                                </span>
                                            </div>

                                        </div>
                                    </div>
                                </div>


                            </div>

                            <div class="mt-12 flex justify-end">
                                <button id="btn-submit-identity" class="px-12 py-4 bg-gray-200 text-gray-400 font-bold tracking-widest uppercase transition-all flex items-center gap-3 cursor-not-allowed" disabled>
                                    <span>身份注册</span>
                                    <Icon name="mdi:fingerprint" class="w-6 h-6" />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>




            </section>

            <section class="col-span-3 flex flex-col relative">
                <div class="relative flex-grow flex flex-col">
                    <div id="sidebar-track" class="absolute left-[4px] top-0 bottom-0 w-[4px] bg-gray-200 z-0 rounded-full">
                        <div id="sidebar-progress" class="w-full bg-[#D00000] h-[0%] transition-all duration-500 rounded-full"></div>
                    </div>

                    <ul id="procedure-list" class="flex-grow flex flex-col space-y-6 z-10 relative">
                        <li id="step-procedure" class="flex items-center">
                            <div class="w-3 h-3 bg-[#D00000] ring-4 ring-white rounded-full shrink-0 flex items-center justify-center z-10"></div>
                            <div class="w-4 shrink-0"></div>
                            <div class="flex-grow bg-[#D00000] text-white p-4 flex items-center gap-3 rounded-l-md rounded-r-full shadow-lg">
                                <span class="block text-3xl font-black tracking-wide uppercase whitespace-nowrap">流程</span>
                                <Icon name="mdi:loading" class="w-7 h-7 shrink-0 animate-spin ml-auto" />
                            </div>
                        </li>

                        <li id="step-handshake" class="flex items-center group">
                            <div class="w-3 h-3 bg-gray-200 ring-4 ring-white rounded-full shrink-0 transition-transform group-hover:scale-110 z-10"></div>
                            <div class="w-4 shrink-0"></div>
                            <div class="flex-grow bg-gray-50 text-gray-400 p-4 flex items-center gap-3 cursor-not-allowed hover:bg-gray-100 transition-colors rounded-l-md rounded-r-full border border-gray-100 border-l-0">
                                <Icon name="mdi:handshake" class="w-7 h-7 shrink-0 opacity-50 group-hover:scale-110 transition-transform" />
                                <span class="block text-lg font-bold tracking-wide whitespace-nowrap">会话握手</span>
                                <div class="ml-auto shrink-0 text-gray-400 text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-gray-200 mr-1 bg-white whitespace-nowrap">
                                    等待中
                                </div>
                            </div>
                        </li>

                        <li id="step-identity" class="flex items-center group">
                            <div class="w-3 h-3 bg-gray-200 ring-4 ring-white rounded-full shrink-0 transition-transform group-hover:scale-110 z-10"></div>
                            <div class="w-4 shrink-0"></div>
                            <div class="flex-grow bg-gray-50 text-gray-400 p-4 flex items-center gap-3 cursor-not-allowed hover:bg-gray-100 transition-colors rounded-l-md rounded-r-full border border-gray-100 border-l-0">
                                <Icon name="mdi:card-account-details-outline" class="w-7 h-7 shrink-0 opacity-50 group-hover:scale-110 transition-transform" />
                                <span class="block text-lg font-bold tracking-wide whitespace-nowrap">身份录入</span>
                                <div class="ml-auto shrink-0 text-gray-400 text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-gray-200 mr-1 bg-white whitespace-nowrap">
                                    锁定
                                </div>
                            </div>
                        </li>

                        <li class="flex items-center">
                            <div class="w-3 h-3 bg-gray-200 ring-4 ring-white rounded-full shrink-0 z-10"></div>
                            <div class="w-4 shrink-0"></div>
                            <div class="flex-grow bg-gray-50 text-gray-400 p-4 flex items-center gap-3 cursor-not-allowed hover:bg-gray-100 transition-colors rounded-l-md rounded-r-full border border-gray-100 border-l-0">
                                <Icon name="mdi:file-document-outline" class="w-7 h-7 shrink-0 opacity-50" />
                                <span class="block text-lg font-bold tracking-wide whitespace-nowrap">信息披露</span>
                                <div class="ml-auto shrink-0 text-gray-400 text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-gray-200 mr-1 bg-white whitespace-nowrap">
                                    锁定

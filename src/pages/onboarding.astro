---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import guideImage from '../assets/character1.png';

// ==========================================
// ROLE TREE: 参数化布局系统
// ==========================================

// 🕹️ 全局间距控制台 (随时在这里调整间距)
const layoutConfig = {
    startX: 300,        // 整棵树距离画布左边缘的初始 Padding
    startY: 1050,       // LV1 距离画布顶部的 Y 轴起点 (因为是从下往上画，所以起点在下方)
    gapX: 210,          // 【核心参数】横向间距倍率：每个 col 之间的宽度
    gapY: 150,          // 【核心参数】纵向间距倍率：每个 row (层级) 之间的高度
    canvasWidth: 4000,  // 画布总宽度 (需大于 startX + 最大 col * gapX)
    canvasHeight: 2000  // 画布总高度
};

// 1. 定义节点的“逻辑位置”
const rawNodes = [
    // --- Root ---
    { id: 'intern', label: 'Intern', lv: 'LV1', dept: 'fractal', status: 'assigned', row: 1, col: 7 },

    // --- LV2 ---
    { id: 'clerk', label: 'Clerk', lv: 'LV2', dept: 'fractal', status: 'locked', row: 2, col: 2 },
    { id: 'security', label: 'Security', lv: 'LV2', dept: 'obliteration', status: 'locked', row: 2, col: 7 },
    { id: 'tech', label: 'Technician', lv: 'LV2', dept: 'origin', status: 'locked', row: 2, col: 12 },

    // --- LV3 ---
    { id: 'archive', label: 'Archivist', lv: 'LV3', dept: 'fractal', status: 'locked', row: 3, col: 0 },
    { id: 'dispatch', label: 'Dispatcher', lv: 'LV3', dept: 'fractal', status: 'locked', row: 3, col: 2 },
    { id: 'contain', label: 'Containmenter', lv: 'LV3', dept: 'fractal', status: 'locked', row: 3, col: 4 },
    { id: 'invest', label: 'Investigator', lv: 'LV3', dept: 'obliteration', status: 'locked', row: 3, col: 6 },
    { id: 'suppress', label: 'Enforcer', lv: 'LV3', dept: 'obliteration', status: 'locked', row: 3, col: 8 },
    { id: 'eng', label: 'Engineer', lv: 'LV3', dept: 'origin', status: 'locked', row: 3, col: 10 },
    { id: 'medic', label: 'Medic', lv: 'LV3', dept: 'origin', status: 'locked', row: 3, col: 12 },
    { id: 'rnd', label: 'Researcher', lv: 'LV3', dept: 'origin', status: 'locked', row: 3, col: 14 },

    // --- LV4 ---
    { id: 'adv-archive', label: 'Senior Archivist', lv: 'LV4', dept: 'fractal', status: 'locked', row: 4, col: 0 },
    { id: 'adv-dispatch', label: 'Senior Dispatcher', lv: 'LV4', dept: 'fractal', status: 'locked', row: 4, col: 2 },
    { id: 'adv-contain', label: 'Senior Containmenter', lv: 'LV4', dept: 'fractal', status: 'locked', row: 4, col: 4 },
    { id: 'adv-invest', label: 'Senior Investigator', lv: 'LV4', dept: 'obliteration', status: 'locked', row: 4, col: 6 },
    { id: 'adv-suppress', label: 'Senior Enforcer', lv: 'LV4', dept: 'obliteration', status: 'locked', row: 4, col: 8 },
    { id: 'adv-eng', label: 'Senior Engineer', lv: 'LV4', dept: 'origin', status: 'locked', row: 4, col: 10 },
    { id: 'adv-medic', label: 'Senior Medic', lv: 'LV4', dept: 'origin', status: 'locked', row: 4, col: 12 }, // 回正到 12
    { id: 'adv-rnd', label: 'Senior Researcher', lv: 'LV4', dept: 'origin', status: 'locked', row: 4, col: 14 },

    // --- LV5 ---
    { id: 'leg-archive', label: 'Elite Archivist', lv: 'LV5', dept: 'fractal', status: 'locked', row: 5, col: 0 },
    { id: 'nexus', label: 'Central Coordinator', lv: 'LV5', dept: 'fractal', status: 'locked', row: 5, col: 1.4 },
    { id: 'aide', label: 'Aide', lv: 'LV5', dept: 'fractal', status: 'locked', row: 5, col: 2.6 },
    { id: 'contain-lead', label: 'Containment Leader', lv: 'LV5', dept: 'fractal', status: 'locked', row: 5, col: 4 },
    { id: 'leg-invest', label: 'Elite Investigator', lv: 'LV5', dept: 'obliteration', status: 'locked', row: 5, col: 6 },
    { id: 'tac-lead', label: 'Tactical Leader', lv: 'LV5', dept: 'obliteration', status: 'locked', row: 5, col: 7.35 },
    { id: 'spec-op', label: 'Tactical Operative', lv: 'LV5', dept: 'obliteration', status: 'locked', row: 5, col: 8.65 },
    { id: 'leg-eng', label: 'Elite Engineer', lv: 'LV5', dept: 'origin', status: 'locked', row: 5, col: 10 },
    { id: 'leg-medic', label: 'Elite Medic', lv: 'LV5', dept: 'origin', status: 'locked', row: 5, col: 12 },
    { id: 'leg-rnd', label: 'Elite Researcher', lv: 'LV5', dept: 'origin', status: 'locked', row: 5, col: 14 },

    // --- LV6 ---
    { id: 'chief-archive', label: 'Chief Archivist', lv: 'LV6', dept: 'fractal', status: 'locked', row: 6, col: 0 },
    { id: 'commander', label: 'Manager', lv: 'LV6', dept: 'fractal', status: 'locked', row: 6, col: 1.4 },
    { id: 'sec-chief', label: '[REDACTED]', lv: 'LV6', dept: 'fractal', status: 'redacted', row: 6, col: 2.6 },
    { id: 'contain-chief', label: 'Containment Supervisor', lv: 'LV6', dept: 'fractal', status: 'locked', row: 6, col: 4 },
    { id: 'chief-invest', label: 'Chief Investigator', lv: 'LV6', dept: 'obliteration', status: 'locked', row: 6, col: 6 },
    { id: 'field-comm', label: 'Field Commander', lv: 'LV6', dept: 'obliteration', status: 'locked', row: 6, col: 7.35 },
    { id: 'term-spec', label: '[REDACTED]', lv: 'LV6', dept: 'obliteration', status: 'redacted', row: 6, col: 8.65 },
    { id: 'chief-eng', label: 'Chief Engineer', lv: 'LV6', dept: 'origin', status: 'locked', row: 6, col: 10 },
    { id: 'chief-med', label: 'Chief Medical Officer', lv: 'LV6', dept: 'origin', status: 'locked', row: 6, col: 12 },
    { id: 'chief-rnd', label: 'Chief Research Officer', lv: 'LV6', dept: 'origin', status: 'locked', row: 6, col: 14 },

    // --- 修改点：LV7 往上移动！把 row 从 7 改成了 7.8，拉开高度差 ---
    { id: 'committee', label: 'The Committee', lv: 'LV7', dept: 'all', status: 'locked', row: 8, col: 7 }
];

// 2. 根据公式自动计算绝对物理坐标 (x, y)
const treeNodes = rawNodes.map(node => ({
    ...node,
    x: layoutConfig.startX + (node.col * layoutConfig.gapX),
    y: layoutConfig.startY - ((node.row - 1) * layoutConfig.gapY)
}));

// 3. 连线关系 (加入 bundleOffset 紧贴参数)
const edgeLinks = [
    { from: 'intern', to: 'clerk' }, { from: 'intern', to: 'security' }, { from: 'intern', to: 'tech' },
    { from: 'intern', to: 'contain' },
    { from: 'clerk', to: 'archive' }, { from: 'clerk', to: 'dispatch' },
    { from: 'security', to: 'invest' }, { from: 'security', to: 'suppress' },
    { from: 'tech', to: 'eng' }, { from: 'tech', to: 'medic' }, { from: 'tech', to: 'rnd' },

    // LV3 -> LV4 (移除了 combat-medic 的连线)
    { from: 'archive', to: 'adv-archive' }, { from: 'dispatch', to: 'adv-dispatch' }, { from: 'contain', to: 'adv-contain' },
    { from: 'invest', to: 'adv-invest' }, { from: 'suppress', to: 'adv-suppress' },
    { from: 'eng', to: 'adv-eng' }, { from: 'medic', to: 'adv-medic' }, { from: 'rnd', to: 'adv-rnd' },

    // LV4 -> LV5 (移除了 combat-medic 汇聚回 leg-medic 的连线)
    { from: 'adv-archive', to: 'leg-archive' }, { from: 'adv-dispatch', to: 'nexus' }, { from: 'adv-dispatch', to: 'aide' },
    { from: 'adv-contain', to: 'contain-lead' }, { from: 'adv-invest', to: 'leg-invest' },
    { from: 'adv-suppress', to: 'tac-lead' }, { from: 'adv-suppress', to: 'spec-op' },
    { from: 'adv-eng', to: 'leg-eng' }, { from: 'adv-medic', to: 'leg-medic' }, { from: 'adv-rnd', to: 'leg-rnd' },

    // LV5 -> LV6
    { from: 'leg-archive', to: 'chief-archive' }, { from: 'nexus', to: 'commander' }, { from: 'aide', to: 'sec-chief' },
    { from: 'contain-lead', to: 'contain-chief' }, { from: 'leg-invest', to: 'chief-invest' },
    { from: 'tac-lead', to: 'field-comm' }, { from: 'spec-op', to: 'term-spec' },
    { from: 'leg-eng', to: 'chief-eng' }, { from: 'leg-medic', to: 'chief-med' }, { from: 'leg-rnd', to: 'chief-rnd' },

    // --- LV6 汇聚至委员会，定义插入点的 X 轴偏移量 (portOffset) 与专属颜色 ---
    // 红线 1 (左侧文职)
    { from: 'chief-archive', to: 'committee', bundleOffset: -12, dept: 'fractal' },
    { from: 'commander', to: 'committee', bundleOffset: -12, dept: 'fractal' },
    // 红线 2 (左侧收容)
    { from: 'contain-chief', to: 'committee', bundleOffset: -4, dept: 'fractal' },
    // 蓝线 (武装)
    { from: 'chief-invest', to: 'committee', bundleOffset: 4, dept: 'obliteration' },
    { from: 'field-comm', to: 'committee', bundleOffset: 4, dept: 'obliteration' },
    // 绿线 (技术)
    { from: 'chief-eng', to: 'committee', bundleOffset: 12, dept: 'origin' },
    { from: 'chief-med', to: 'committee', bundleOffset: 12, dept: 'origin' },
    { from: 'chief-rnd', to: 'committee', bundleOffset: 12, dept: 'origin' }
];

// 4. 计算贝塞尔曲线与汇聚直线的路径
// 4. 计算路径：LV7使用硬朗直线，其余保留曲线
const nodeMap = Object.fromEntries(treeNodes.map(n => [n.id, n]));
const treeEdges = edgeLinks.map(link => {
    const start = nodeMap[link.from];
    const end = nodeMap[link.to];

    // 如果终点是委员会，执行“直线汇聚、再平行垂直插入”的专属路径逻辑
    if (link.to === 'committee' && link.bundleOffset !== undefined) {
        // 目标 X 坐标：委员会中心 + 细微偏移，形成排线
        const portX = end.x + link.bundleOffset;

        // 汇聚点的高度：位于委员会下方 200px 处，之后转为笔直向上的垂直线
        const convergeY = end.y + 200;

        // 路径修改：移除了贝塞尔曲线的 C 锚点，直接用直线 L 画斜线到 convergeY，再用直线 L 垂直插入
        const path = `M ${start.x} ${start.y} L ${portX} ${convergeY} L ${portX} ${end.y}`;

        return { ...link, path, dept: link.dept };
    } else {
        // 常规节点连线保持 S 型曲线
        const path = `M ${start.x} ${start.y} C ${start.x} ${(start.y + end.y)/2}, ${end.x} ${(start.y + end.y)/2}, ${end.x} ${end.y}`;
        return { ...link, path, dept: end.dept };
    }
});

const getDeptColor = (dept) => {
    if (dept === 'fractal') return '#D00000';
    if (dept === 'obliteration') return '#0058C0';
    if (dept === 'origin') return '#009900';
    return '#6b7280';
};
---

<Layout>
    <div class="min-h-screen bg-white flex flex-col p-6 pb-0 overflow-hidden selection:bg-[#D00000] selection:text-white">


        <div class="fixed top-4 right-4 z-[99999] flex flex-col gap-2">
            <button id="dev-skip-btn" class="bg-black text-lime-400 border border-lime-400 px-4 py-2 text-xs font-mono font-bold hover:bg-lime-400 hover:text-black transition-colors cursor-pointer shadow-lg shadow-black/50">
                [DEV] SKIP TO DISCLOSURE
            </button>
            <button id="dev-skip-role-btn" class="bg-black text-cyan-400 border border-cyan-400 px-4 py-2 text-xs font-mono font-bold hover:bg-cyan-400 hover:text-black transition-colors cursor-pointer shadow-lg shadow-black/50">
                [DEV] SKIP TO ROLE ASSIGN
            </button>
        </div>

        <header class=" mb-4 border-b-12 border-[#D00000] pb-4 flex justify-between items-end shrink-0">
            <h1 class="text-[#D00000] text-6xl font-black tracking-wide uppercase">
                Welcome to Fractal Shelter
            </h1>
            <Icon class="inline-block w-16 h-16 text-[#D00000] " name="logo"  id="hero-logo" transition:name="fractal-logo"></Icon>
        </header>

        <main class="grid grid-cols-16 gap-12 flex-grow h-full min-h-0 mt-4">

            <section class="col-span-9 flex flex-col relative overflow-hidden pr-0 bg-transparent border-none">

                <div class="flex items-center gap-4 mb-4 text-[#D00000]">
                    <h2 id="section-title" class="text-5xl font-black tracking-widest uppercase">Session Handshake</h2>

                    <div class="h-3 flex-grow bg-gray-100 relative">
                        <div id="handshake-progress-bar" class="absolute top-0 left-0 h-full bg-[#D00000] w-0"></div>
                    </div>
                    <span id="handshake-status" class=" text-xl font-bold uppercase text-gray-400 min-w-[120px] text-right">Pending</span>
                </div>

                <div id="handshake-container" class="flex-grow relative w-full mt-8 mb-8">
                    <svg class="absolute inset-0 w-full h-full z-0 pointer-events-none">
                        <path id="bg-path" fill="none" stroke="#f3f4f6" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter" />
                        <path id="active-path" fill="none" stroke="#D00000" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter" />
                    </svg>

                    <div class="relative z-10 grid grid-cols-3 gap-y-16 w-full h-full px-12 pb-8">
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="0">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">01</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Link</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="1">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">02</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Auth</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="2">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">03</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Sync</span>
                        </div>

                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="5">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">06</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Route</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="4">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">05</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Decrypt</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="3">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">04</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Verify</span>
                        </div>

                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="6">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">07</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Map</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="7">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">08</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Inject</span>
                        </div>
                        <div class="flex flex-col items-center justify-center">
                            <button class="node-btn group relative outline-none" data-index="8">
                                <span class="block bg-white px-4 text-6xl font-black text-gray-200 transition-colors duration-150">09</span>
                            </button>
                            <span class="node-label mt-4  text-xl uppercase tracking-widest text-gray-300 transition-colors duration-150 bg-white px-2 relative z-10">Connect</span>
                        </div>
                    </div>

                    <button id="btn-handshake-complete" class="absolute bottom-4 right-8 opacity-0 pointer-events-none translate-y-4 px-10 py-4 bg-[#D00000] text-white font-bold tracking-widest uppercase transition-colors hover:bg-[#a00000] z-20">
                        Connect
                    </button>
                </div>

                <div id="identity-container" class="flex-grow relative w-full mt-4 mb-8 hidden opacity-0 flex-col justify-center">
                    <div class="bg-gray-50 border-l-8 border-[#D00000] p-10 shadow-lg mx-8 relative overflow-hidden">
                        <Icon name="mdi:card-account-details-outline" class="absolute -bottom-10 -right-10 w-64 h-64 text-gray-100 rotate-12 pointer-events-none" />

                        <div class="relative z-10">
                            <h3 class="text-4xl font-black text-[#D00000] uppercase mb-8 tracking-wide">Subject Registration</h3>

                            <div class="space-y-6">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="flex flex-col group">
                                        <label class="text-base font-black text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="legal-name">
                                            Legal Name <span class="text-[#D00000]">*</span>
                                        </label>
                                        <input type="text" id="legal-name" maxlength="24" class="bg-white border-2 border-gray-200 p-3 font-bold text-lg  text-gray-800 focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all placeholder:text-gray-300" placeholder="Enter your legal name..." autocomplete="off" />
                                        <span id="name-error" class="text-xs text-[#D00000] mt-1 hidden ">Name is required and cannot be purely spaces.</span>
                                    </div>
                                    <div class="flex flex-col group relative">
                                        <label class="text-base font-black font-bold text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="codename">
                                            Codename / Alias
                                        </label>
                                        <input type="text" id="codename" maxlength="20" class="bg-white border-2 border-gray-200 p-3 text-lg font-bold text-gray-800 focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all placeholder:text-gray-300" placeholder="Optional (e.g., ARCH-02)" autocomplete="off" />
                                        <div id="draft-badge" class="absolute right-3 top-[48px] opacity-0 transition-opacity pointer-events-none">
                                            <span class="bg-gray-100 text-gray-400 border border-gray-200 text-[12px] font-black px-2 py-1 rounded-sm uppercase tracking-widest">Draft</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div class="flex flex-col group">
                                        <label class=" text-base font-black font-bold text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="age">
                                            Age <span class="text-[#D00000]">*</span>
                                        </label>
                                        <div class="relative">
                                            <select id="age" class="w-full bg-white border-2 border-gray-200 p-3 text-lg text-gray-400 font-bold focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all appearance-none cursor-pointer">
                                                <option value="" selected disabled hidden>Select Age...</option>
                                                {Array.from({ length: 45 }, (_, i) => i + 16).map((age) => (
                                                        <option value={age}>{age}</option>
                                                ))}
                                            </select>
                                            <Icon name="mdi:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col group">
                                        <label class=" text-base font-black text-gray-400 uppercase tracking-widest mb-2 group-focus-within:text-[#D00000] transition-colors" for="month">
                                            Birth Month <span class="text-[#D00000]">*</span>
                                        </label>
                                        <div class="relative">
                                            <select id="month" class="w-full bg-white border-2 border-gray-200 p-3 text-lg text-gray-400 font-bold focus:text-[#D00000] focus:outline-none focus:border-[#D00000] focus:ring-4 focus:ring-red-50 transition-all appearance-none cursor-pointer">
                                                <option value="" selected disabled hidden>Select Month...</option>

                                                {[
                                                    {val: 1, label: "01 - JAN"}, {val: 2, label: "02 - FEB"}, {val: 3, label: "03 - MAR"},
                                                    {val: 4, label: "04 - APR"}, {val: 5, label: "05 - MAY"}, {val: 6, label: "06 - JUN"},
                                                    {val: 7, label: "07 - JUL"}, {val: 8, label: "08 - AUG"}, {val: 9, label: "09 - SEP"},
                                                    {val: 10, label: "10 - OCT"}, {val: 11, label: "11 - NOV"}, {val: 12, label: "12 - DEC"}
                                                ].map(m => <option value={m.val}>{m.label}</option>)}
                                            </select>
                                            <Icon name="mdi:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 w-6 h-6 text-gray-400 pointer-events-none" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col group" id="gender-section">
                                        <label id="gender-label" class="text-base font-black text-gray-400 uppercase tracking-widest mb-2 transition-colors">
                                            Gender <span class="text-[#D00000]">*</span>
                                        </label>

                                        <div class="flex items-center gap-4 w-full h-[52px]">


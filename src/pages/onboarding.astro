        // ==========================================
// 8. Role Tree Interaction & Canvas Logic
// ==========================================
        const roleViewport = document.getElementById('tree-viewport');
        const roleCanvas = document.getElementById('tree-canvas');
        const roleNodes = document.querySelectorAll('.tree-node');
        const edgePaths = document.querySelectorAll('.edge-path');
        const roleToast = document.getElementById('role-toast');
        let toastTimeout;

// -- Pan & Zoom State --
        let treeScale = 0.8; // Initial scale
        let treeX = -1800;
        let treeY = -700; // Offset Y so the root (LV1) starts near the bottom
        let isPanning = false;
        let startX, startY, startPanX, startPanY;

        function updateTreeTransform(duration = 0) {
            if (roleCanvas) {
                gsap.to(roleCanvas, { x: treeX, y: treeY, scale: treeScale, duration: duration, ease: "power2.out" });
            }
        }

// Initial positioning
        updateTreeTransform();

        if (roleViewport) {
            // Zoom via Scroll Wheel
            roleViewport.addEventListener('wheel', (e) => {
                e.preventDefault();
                const zoomDelta = e.deltaY > 0 ? -0.1 : 0.1;
                treeScale = Math.min(Math.max(0.4, treeScale + zoomDelta), 1.8);
                updateTreeTransform(0.2);
            });

            // Pan via Mouse Drag
            roleViewport.addEventListener('mousedown', (e) => {
                if (e.target.closest('button')) return; // Ignore buttons
                isPanning = true;
                startX = e.clientX;
                startY = e.clientY;
                startPanX = treeX;
                startPanY = treeY;
                roleViewport.classList.add('active:cursor-grabbing');
            });

            window.addEventListener('mousemove', (e) => {
                if (!isPanning) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                treeX = startPanX + dx;
                treeY = startPanY + dy;
                updateTreeTransform(0); // Instant update for smooth drag
            });

            window.addEventListener('mouseup', () => { isPanning = false; roleViewport.classList.remove('active:cursor-grabbing'); });
            window.addEventListener('mouseleave', () => { isPanning = false; });
        }

// UI Controls
        document.getElementById('zoom-in')?.addEventListener('click', () => { treeScale = Math.min(1.8, treeScale + 0.2); updateTreeTransform(0.3); });
        document.getElementById('zoom-out')?.addEventListener('click', () => { treeScale = Math.max(0.4, treeScale - 0.2); updateTreeTransform(0.3); });
        document.getElementById('reset-view')?.addEventListener('click', () => { treeScale = 0.8; treeX = -1800; treeY = -700; updateTreeTransform(0.5); });

// -- Node Hover Highlight & Toast Logic --
        roleNodes.forEach(node => {
            // 鼠标移入：高亮关联连线
            node.addEventListener('mouseenter', () => {
                const nodeId = node.dataset.id;
                document.querySelectorAll(`.from-${nodeId} .edge-path, .to-${nodeId} .edge-path`).forEach(path => {
                    const deptColor = path.dataset.deptColor;
                    path.setAttribute('stroke', deptColor);
                    path.setAttribute('stroke-width', '5');

                    // 【核心修复】：把当前高亮的连线所在的 <g> 标签提到最前面
                    // 原理：把节点重新 append 到父容器，它就会跑到 DOM 树的最末尾，从而实现在最上层渲染
                    const groupElement = path.closest('g');
                    if (groupElement && groupElement.parentNode) {
                        groupElement.parentNode.appendChild(groupElement);
                    }
                });
            });

            // 鼠标移出：无脑恢复为默认灰色 (这部分保持你现在的代码不变)
            node.addEventListener('mouseleave', () => {
                const nodeId = node.dataset.id;
                document.querySelectorAll(`.from-${nodeId} .edge-path, .to-${nodeId} .edge-path`).forEach(path => {
                    path.setAttribute('stroke', '#e5e7eb');
                    path.setAttribute('stroke-width', '3');
                });
            });
            // Click: Toast Notification
            node.addEventListener('click', () => {
                if (isPanning && (Math.abs(treeX - startPanX) > 5)) return; // 拖拽时不触发点击

                const status = node.dataset.status;

                if (status === 'assigned') {
                    roleToast.textContent = "ROLE LOCKED-IN: INTERN (LV1)";
                    roleToast.className = "absolute top-24 left-1/2 -translate-x-1/2 bg-[#D00000] text-white px-6 py-3 uppercase tracking-widest font-black text-sm opacity-100 transition-opacity border-2 border-red-300 shadow-xl z-50";
                } else if (status === 'redacted') {
                    roleToast.textContent = "ACCESS DENIED: INTERNAL CANDIDATES ONLY";
                    roleToast.className = "absolute top-24 left-1/2 -translate-x-1/2 bg-black text-red-500 px-6 py-3 uppercase tracking-widest font-black text-sm opacity-100 transition-opacity border-2 border-red-900 shadow-xl z-50";
                } else {
                    roleToast.textContent = "LOCKED: REQUIRES DEPARTMENT CLEARANCE";
                    roleToast.className = "absolute top-24 left-1/2 -translate-x-1/2 bg-gray-800 text-gray-200 px-6 py-3 uppercase tracking-widest font-bold text-sm opacity-100 transition-opacity shadow-xl z-50";
                }

                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => { roleToast.classList.replace('opacity-100', 'opacity-0'); }, 2000);
            });
        });

// --- Submit Role Assignment ---
        const btnSubmitRole = document.getElementById('btn-submit-role');
        if (btnSubmitRole) {
            btnSubmitRole.addEventListener('click', () => {
                btnSubmitRole.disabled = true;
                const tl = gsap.timeline();

                // 1. 原有的：按钮隐藏
                tl.to(btnSubmitRole, { opacity: 0, y: 10, duration: 0.2, pointerEvents: "none" });

                // 2. 原有的：点亮左侧边栏的 Role 步骤
                tl.add(() => {
                    const stepRole = document.getElementById('step-role');
                    if (stepRole) {
                        const body = stepRole.querySelector('.flex-grow');
                        const badge = stepRole.querySelector('.ml-auto');
                        const dot = stepRole.querySelector('.w-3.h-3');
                        const icon = stepRole.querySelector('svg');
                        const textSpan = stepRole.querySelector('span');

                        body.className = "flex-grow bg-[#D00000] text-white p-4 flex items-center gap-3 hover:bg-red-700 transition-colors rounded-l-md rounded-r-full shadow-md cursor-pointer";
                        badge.className = "ml-auto shrink-0 bg-white text-[#D00000] text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full mr-1 shadow-sm whitespace-nowrap";
                        badge.textContent = "Verified";
                        dot.className = "w-3 h-3 bg-[#D00000] ring-4 ring-white rounded-full shrink-0 transition-transform group-hover:scale-110 z-10";

                        if(icon) icon.classList.replace('opacity-50', 'opacity-100');
                        if(textSpan) textSpan.classList.replace('font-bold', 'font-black');

                        updateSidebarProgress('step-role');
                    }
                }, "+=0.1");

                // 3. 新增：向 Access Issuance (Clearance) 过渡
                tl.to('#role-container', {
                    opacity: 0,
                    y: -20,
                    duration: 0.3,
                    onComplete: () => {
                        // 隐藏职业树，显示权限清单
                        document.getElementById('role-container').classList.add('hidden');
                        document.getElementById('clearance-container').classList.remove('hidden');

                        // 动态获取之前在表单阶段填写的代号或真实姓名
                        const codename = document.getElementById('codename')?.value.trim();
                        const legalName = document.getElementById('legal-name')?.value.trim();
                        const displayName = codename || legalName || "UNKNOWN_SUBJECT";
                        document.getElementById('display-subject-name').textContent = displayName;

                        // 更改顶部全局标题
                        document.getElementById('section-title').textContent = "Access Issuance";

                        // 顶部状态栏：开始生成
                        const statusText = document.getElementById('handshake-status');
                        statusText.textContent = "ISSUING...";
                        statusText.classList.replace('text-[#D00000]', 'text-gray-400');
                        statusText.classList.replace('font-black', 'font-bold');

                        // 进度条清零，准备开始灌入
                        gsap.set('#handshake-progress-bar', { width: "0%" });
                    }
                }).fromTo('#clearance-container',
                    { opacity: 0, y: 20 },
                    { opacity: 1, y: 0, duration: 0.4, ease: "power2.out", onComplete: () => {
                            // 进场完毕后，启动权限发放的读条动画
                            gsap.to('#handshake-progress-bar', { width: "100%", duration: 1.2, ease: "power2.inOut" });

                            // 读条结束后，状态变红锁定
                            setTimeout(() => {
                                const statusText = document.getElementById('handshake-status');
                                statusText.textContent = "ISSUED: LV1";
                                statusText.classList.replace('text-gray-400', 'text-[#D00000]');
                                statusText.classList.replace('font-bold', 'font-black');
                            }, 1200);
                        }}
                );
            });
        }



    // ==========================================
    // 🛠️ 临时：开发者一键跳过到 Disclosure 阶段
    // ==========================================
    const devSkipBtn = document.getElementById('dev-skip-btn');
    if (devSkipBtn) {
        devSkipBtn.addEventListener('click', () => {
            // 1. 强制杀死所有正在播放的 GSAP 动画，防止串台
            gsap.killTweensOf("*");

            // 2. 隐藏握手和表单阶段，直接显示协议阶段
            document.getElementById('handshake-container').classList.add('hidden');
            document.getElementById('identity-container').classList.add('hidden');

            const discContainer = document.getElementById('disclosure-container');
            discContainer.classList.remove('hidden');
            gsap.set(discContainer, { opacity: 1, y: 0 }); // 强制可见

            // 3. 更新顶部全局状态
            document.getElementById('section-title').textContent = "Disclosure";
            const statusText = document.getElementById('handshake-status');
            statusText.textContent = "Pending Signature";
            statusText.className = "text-xl font-bold uppercase text-gray-400 min-w-[120px] text-right";
            gsap.set('#handshake-progress-bar', { width: "0%" });

            // 4. 将左侧侧边栏的前两步全部强制绿灯/红灯通过
            ['step-handshake', 'step-identity'].forEach(id => {
                const step = document.getElementById(id);
                if (step) {
                    const body = step.querySelector('.flex-grow');
                    const badge = step.querySelector('.ml-auto');
                    const dot = step.querySelector('.w-3.h-3');
                    const icon = step.querySelector('svg');
                    const textSpan = step.querySelector('span');

                    body.className = "flex-grow bg-[#D00000] text-white p-4 flex items-center gap-3 rounded-l-md rounded-r-full shadow-md";
                    badge.className = "ml-auto shrink-0 bg-white text-[#D00000] text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full mr-1 shadow-sm whitespace-nowrap";
                    badge.textContent = "Verified";
                    dot.className = "w-3 h-3 bg-[#D00000] ring-4 ring-white rounded-full shrink-0 z-10";
                    if(icon) icon.classList.replace('opacity-50', 'opacity-100');
                    if(textSpan) textSpan.classList.replace('font-bold', 'font-black');
                }
            });

            // 5. 将左侧拉伸线直接对准 Disclosure
            updateSidebarProgress('step-disclosure');
        });


        // ==========================================
        // 🛠️ 临时：开发者一键跳过到 Role Assignment 阶段
        // ==========================================
        const devSkipRoleBtn = document.getElementById('dev-skip-role-btn');
        if (devSkipRoleBtn) {
            devSkipRoleBtn.addEventListener('click', () => {
                // 1. 强制杀死所有正在播放的 GSAP 动画
                gsap.killTweensOf("*");

                // 2. 隐藏前面的所有阶段
                document.getElementById('handshake-container').classList.add('hidden');
                document.getElementById('identity-container').classList.add('hidden');
                document.getElementById('disclosure-container').classList.add('hidden');
                document.getElementById('vetting-container').classList.add('hidden');

                // 显示 Role 阶段
                const roleContainer = document.getElementById('role-container');
                if (roleContainer) {
                    roleContainer.classList.remove('hidden');
                    gsap.set(roleContainer, { opacity: 1, y: 0 }); // 强制可见
                }

                // 3. 更新顶部全局状态
                const titleEl = document.getElementById('section-title');
                if(titleEl) titleEl.textContent = "Role Assignment";

                const statusText = document.getElementById('handshake-status');
                if(statusText) {
                    statusText.textContent = "ASSIGNED: INTERN (LV1)";
                    statusText.className = "text-xl font-black uppercase text-[#D00000] min-w-[120px] text-right";
                }
                gsap.set('#handshake-progress-bar', { width: "100%" });

                // 4. 将左侧侧边栏的前四步全部强制绿灯通过
                ['step-handshake', 'step-identity', 'step-disclosure', 'step-vetting'].forEach(id => {
                    const step = document.getElementById(id);
                    if (step) {
                        const body = step.querySelector('.flex-grow');
                        const badge = step.querySelector('.ml-auto');
                        const dot = step.querySelector('.w-3.h-3');
                        const icon = step.querySelector('svg');
                        const textSpan = step.querySelector('span');

                        if(body) body.className = "flex-grow bg-[#D00000] text-white p-4 flex items-center gap-3 rounded-l-md rounded-r-full shadow-md";
                        if(badge) {
                            badge.className = "ml-auto shrink-0 bg-white text-[#D00000] text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full mr-1 shadow-sm whitespace-nowrap";
                            badge.textContent = "Verified";
                        }
                        if(dot) dot.className = "w-3 h-3 bg-[#D00000] ring-4 ring-white rounded-full shrink-0 z-10";
                        if(icon) icon.classList.replace('opacity-50', 'opacity-100');
                        if(textSpan) textSpan.classList.replace('font-bold', 'font-black');
                    }
                });

                // 5. 将左侧拉伸线直接对准 Role Assignment
                updateSidebarProgress('step-vetting');
            });
        }






    }





});

</script>